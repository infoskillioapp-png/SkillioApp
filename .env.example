# =============================================================================
# Skilio · plantilla de variables de entorno
# Copiá este archivo como .env.local y completá los valores reales.
# Este archivo (.env.example) SÍ se sube a git como referencia.
# .env.local NUNCA se sube — está gitignoreado.
# =============================================================================

# ---- Supabase (DB + Storage) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo backend (server). NO exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Clerk (Auth) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/registro
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app

# ---- Anthropic (Claude API) ----
ANTHROPIC_API_KEY=

# ---- Supabase Management API (Personal Access Token, user-level) ----
# Crear en https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
